generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String    @unique
  phone                   String    @unique
  fullName                String    @map("full_name")
  passwordHash            String    @map("password_hash")
  licenseNumber           String?   @map("license_number")
  specialization          String?
  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified         Boolean   @default(false) @map("is_phone_verified")
  isActive                Boolean   @default(true) @map("is_active")
  emailVerificationToken  String?   @map("email_verification_token")
  emailVerificationExpiry DateTime? @map("email_verification_expiry")
  passwordResetToken      String?   @map("password_reset_token")
  passwordResetExpiry     DateTime? @map("password_reset_expiry")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  clinicMemberships  ClinicMember[]
  ownedClinics       Clinic[]
  refreshTokens      RefreshToken[]
  deviceTokens       DeviceToken[]
  consultationsAsVet Consultation[] @relation("ConsultationVet")

  @@map("users")
}

model Clinic {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  address          String
  contactPhone     String    @map("contact_phone")
  city             String?
  gstin            String?
  logoUrl          String?   @map("logo_url")
  workingHours     Json?     @map("working_hours")
  wizardCompletedAt DateTime? @map("wizard_completed_at")
  ownerId          String    @map("owner_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  owner              User                @relation(fields: [ownerId], references: [id])
  members            ClinicMember[]
  petOwners          PetOwner[]
  pets               Pet[]
  queueEntries       QueueEntry[]
  consultations      Consultation[]
  consultationDrafts ConsultationDraft[]
  vaccinationRecords VaccinationRecord[]
  dewormingRecords   DewormingRecord[]
  drugs              Drug[]
  serviceCatalog     ServiceCatalog[]

  @@map("clinics")
}

model ClinicMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user                User                      @relation(fields: [userId], references: [id])
  clinic              Clinic                    @relation(fields: [clinicId], references: [id])
  roles               ClinicMemberRole[]
  permissionOverrides UserPermissionOverride[]

  @@unique([userId, clinicId])
  @@map("clinic_members")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  memberRoles     ClinicMemberRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique
  description String
  module      String

  rolePermissions     RolePermission[]
  permissionOverrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model ClinicMemberRole {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicMemberId String   @map("clinic_member_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  clinicMember ClinicMember @relation(fields: [clinicMemberId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([clinicMemberId, roleId])
  @@map("clinic_member_roles")
}

model UserPermissionOverride {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicMemberId String  @map("clinic_member_id") @db.Uuid
  permissionId   String  @map("permission_id") @db.Uuid
  granted        Boolean

  clinicMember ClinicMember @relation(fields: [clinicMemberId], references: [id])
  permission   Permission   @relation(fields: [permissionId], references: [id])

  @@unique([clinicMemberId, permissionId])
  @@map("user_permission_overrides")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id") @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model AuthAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  clinicId  String?  @map("clinic_id") @db.Uuid
  event     String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([clinicId])
  @@index([event])
  @@map("auth_audit_log")
}

model Notification {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  type            String
  module          String
  title           String
  body            String
  data            Json     @default("{}")
  isRead          Boolean  @default(false) @map("is_read")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([recipientUserId, clinicId, isRead])
  @@index([recipientUserId, clinicId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@map("device_tokens")
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  FISH
  REPTILE
  OTHER
}

enum QueueEntryStatus {
  WAITING
  IN_CONSULT
  DONE
  NO_SHOW
}

model PetOwner {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  mobile    String
  name      String
  email     String?
  address   String?
  altPhone  String?  @map("alt_phone")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])
  pets   Pet[]

  @@unique([clinicId, mobile])
  @@index([clinicId])
  @@index([clinicId, name])
  @@map("pet_owners")
}

model Pet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  species     Species
  breed       String?
  birthYear   Int?     @map("birth_year")
  birthMonth  Int?     @map("birth_month")
  weight      Float?
  color       String?
  microchipId String?  @map("microchip_id")
  photoUrl    String?  @map("photo_url")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  owner              PetOwner            @relation(fields: [ownerId], references: [id])
  queueEntries       QueueEntry[]
  consultations      Consultation[]
  vaccinationRecords VaccinationRecord[]
  dewormingRecords   DewormingRecord[]

  @@index([clinicId])
  @@index([clinicId, ownerId])
  @@index([clinicId, name])
  @@map("pets")
}

model QueueEntry {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId      String           @map("clinic_id") @db.Uuid
  petId         String           @map("pet_id") @db.Uuid
  checkedInBy   String           @map("checked_in_by") @db.Uuid
  treatingVetId String?          @map("treating_vet_id") @db.Uuid
  status        QueueEntryStatus @default(WAITING)
  position      Int
  isEmergency   Boolean          @default(false) @map("is_emergency")
  visitReason   String?          @map("visit_reason")
  checkedInAt   DateTime         @default(now()) @map("checked_in_at")
  calledAt      DateTime?        @map("called_at")
  completedAt   DateTime?        @map("completed_at")
  archivedAt    DateTime?        @map("archived_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])
  pet    Pet    @relation(fields: [petId], references: [id])

  @@index([clinicId, status])
  @@index([clinicId, checkedInAt])
  @@index([clinicId, petId, checkedInAt])
  @@map("queue_entries")
}

model ConsentRecord {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String?   @map("owner_id") @db.Uuid
  consentType String    @map("consent_type")
  purposeText String    @map("purpose_text")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  ipAddress   String?   @map("ip_address")
  actorId     String?   @map("actor_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("consent_records")
}

// ─── Phase 4: EMR & Clinical Records ─────────────────────────────────

model Consultation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid
  petId            String    @map("pet_id") @db.Uuid
  vetId            String    @map("vet_id") @db.Uuid
  queueEntryId     String?   @map("queue_entry_id") @db.Uuid
  visitType        String    @default("general") @map("visit_type")
  status           String    @default("draft")
  startedAt        DateTime  @default(now()) @map("started_at")
  finalizedAt      DateTime? @map("finalized_at")
  durationMinutes  Int?      @map("duration_minutes")
  subjective       Json?
  objective        Json?
  assessment       String?
  plan             Json?
  careInstructions String?   @map("care_instructions")
  referral         Json?
  rxNotes          String?   @map("rx_notes")
  followUpDate     DateTime? @map("follow_up_date")
  followUpReason   String?   @map("follow_up_reason")
  addenda          Json?     @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  clinic             Clinic                  @relation(fields: [clinicId], references: [id])
  pet                Pet                     @relation(fields: [petId], references: [id])
  vet                User                    @relation("ConsultationVet", fields: [vetId], references: [id])
  vitals             Vitals?
  prescriptions      Prescription[]
  attachments        ConsultationAttachment[]
  vaccinationRecords VaccinationRecord[]
  dewormingRecords   DewormingRecord[]

  @@index([clinicId])
  @@index([clinicId, petId])
  @@index([clinicId, vetId])
  @@index([clinicId, status])
  @@map("consultations")
}

model ConsultationDraft {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String   @unique @map("consultation_id") @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  data           Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("consultation_drafts")
}

model ConsultationLock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String   @unique @map("consultation_id") @db.Uuid
  vetId          String   @map("vet_id") @db.Uuid
  vetName        String   @map("vet_name")
  acquiredAt     DateTime @default(now()) @map("acquired_at")
  lastHeartbeat  DateTime @default(now()) @map("last_heartbeat")
  expiresAt      DateTime @map("expires_at")

  @@map("consultation_locks")
}

model Vitals {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId  String   @unique @map("consultation_id") @db.Uuid
  weightKg        Decimal? @map("weight_kg") @db.Decimal(6, 2)
  temperatureC    Decimal? @map("temperature_c") @db.Decimal(4, 1)
  heartRateBpm    Int?     @map("heart_rate_bpm")
  respiratoryRate Int?     @map("respiratory_rate")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("vitals")
}

model Drug {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String? @map("clinic_id") @db.Uuid
  name        String
  genericName String  @map("generic_name")
  category    String
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic        Clinic?          @relation(fields: [clinicId], references: [id])
  formulations  DrugFormulation[]
  dosageRanges  SpeciesDosage[]

  @@index([name])
  @@index([genericName])
  @@map("drugs")
}

model DrugFormulation {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drugId        String  @map("drug_id") @db.Uuid
  form          String
  strength      String
  strengthValue Decimal @map("strength_value") @db.Decimal(10, 2)
  strengthUnit  String  @map("strength_unit")

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@map("drug_formulations")
}

model SpeciesDosage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drugId         String   @map("drug_id") @db.Uuid
  species        String
  minDoseMgPerKg Decimal  @map("min_dose_mg_per_kg") @db.Decimal(10, 4)
  maxDoseMgPerKg Decimal  @map("max_dose_mg_per_kg") @db.Decimal(10, 4)
  isFixedDose    Boolean  @default(false) @map("is_fixed_dose")
  fixedDoseMin   Decimal? @map("fixed_dose_min") @db.Decimal(10, 2)
  fixedDoseMax   Decimal? @map("fixed_dose_max") @db.Decimal(10, 2)
  notes          String?

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@unique([drugId, species])
  @@map("species_dosages")
}

model Prescription {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId       String   @map("consultation_id") @db.Uuid
  drugId               String?  @map("drug_id") @db.Uuid
  drugName             String   @map("drug_name")
  formulationId        String?  @map("formulation_id") @db.Uuid
  formulation          String
  strength             String
  dosage               String
  dosageMg             Decimal? @map("dosage_mg") @db.Decimal(10, 2)
  route                String
  frequency            String
  duration             String
  durationDays         Int?     @map("duration_days")
  clinicalInstructions String?  @map("clinical_instructions")
  ownerInstructions    String?  @map("owner_instructions")
  dispensed            Boolean  @default(false)
  inventoryItemId      String?  @map("inventory_item_id") @db.Uuid
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@index([consultationId])
  @@map("prescriptions")
}

model VaccinationRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId        String    @map("clinic_id") @db.Uuid
  petId           String    @map("pet_id") @db.Uuid
  consultationId  String?   @map("consultation_id") @db.Uuid
  vaccineName     String    @map("vaccine_name")
  batchNumber     String?   @map("batch_number")
  manufacturer    String?
  expiryDate      DateTime? @map("expiry_date")
  administeredAt  DateTime  @map("administered_at")
  administeredBy  String    @map("administered_by") @db.Uuid
  nextDueDate     DateTime? @map("next_due_date")
  createdAt       DateTime  @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  pet          Pet           @relation(fields: [petId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([clinicId, petId])
  @@index([clinicId, petId, vaccineName])
  @@map("vaccination_records")
}

model DewormingRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  petId          String    @map("pet_id") @db.Uuid
  consultationId String?   @map("consultation_id") @db.Uuid
  drugName       String    @map("drug_name")
  administeredAt DateTime  @map("administered_at")
  administeredBy String    @map("administered_by") @db.Uuid
  nextDueDate    DateTime? @map("next_due_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  pet          Pet           @relation(fields: [petId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([clinicId, petId])
  @@map("deworming_records")
}

model ConsultationAttachment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId  String   @map("consultation_id") @db.Uuid
  fileType        String   @map("file_type")
  fileName        String   @map("file_name")
  mimeType        String   @map("mime_type")
  fileSizeBytes   Int      @map("file_size_bytes")
  s3Key           String   @map("s3_key")
  s3Url           String?  @map("s3_url")
  thumbnailS3Key  String?  @map("thumbnail_s3_key")
  description     String?
  uploadedBy      String   @map("uploaded_by") @db.Uuid
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@index([consultationId])
  @@map("consultation_attachments")
}

// ─── Phase 4: Service Catalog (Pre-Phase 6 Billing) ────────────────

model ServiceCatalog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  name            String
  category        String   @default("other")
  price           Int      // price in paise
  sacCode         String?  @map("sac_code")
  hsnCode         String?  @map("hsn_code")
  gstRateOverride Decimal? @map("gst_rate_override") @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")
  isPreset        Boolean  @default(false) @map("is_preset")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, isActive])
  @@index([clinicId, category])
  @@map("service_catalog")
}
