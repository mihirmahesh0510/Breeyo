# API
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
# Externally reachable base URL, used to build the per-clinic Razorpay webhook
# URL that GET /billing/settings shows an Admin to paste into their Razorpay
# dashboard (D-29, plan 06-12). It must be the address RAZORPAY can reach, which
# in local development is a tunnel (ngrok/cloudflared), not localhost.
# Falls back to API_URL when unset; when neither is set the settings screen
# reports the webhook as unconfigured rather than showing a broken URL.
PUBLIC_API_URL=http://localhost:3000

# Database (migration user - owns tables)
DATABASE_URL=postgresql://breeyo_admin:dev_password_only@localhost:5433/breeyo?schema=public

# Database (app user - RLS enforced)
DATABASE_URL_APP=postgresql://breeyo_app:app_dev_password@localhost:5433/breeyo?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
COOKIE_SECRET=dev-cookie-secret-change-in-production

# OTP (MSG91 - per D-07)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=BREEYO
MSG91_TEMPLATE_ID=your_otp_template_id

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass
EMAIL_FROM=noreply@breeyo.app

# Sentry (per D-34)
SENTRY_DSN=

# Client URLs
WEB_URL=http://localhost:3001
MOBILE_URL=exp://localhost:8081

# AWS Region (per D-33, PLT-05)
AWS_REGION=ap-south-1

# Billing / Razorpay (Phase 6 - BIL-05, BIL-06)
# 32-byte hex key for AES-256-GCM encryption of per-clinic Razorpay secrets at
# rest (per D-29, plan 06-06). Generate with: openssl rand -hex 32
# WARNING: rotating this key invalidates every stored clinic secret.
BILLING_ENCRYPTION_KEY=
# Development-only fallback, used when a clinic row has no stored credentials so
# local BIL-05 work does not require seeding encrypted secrets. Never set these
# in staging or production - real clinics use their own per-clinic keys.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Per-clinic webhook path token used by the dev tunnel (plan 06-10).
RAZORPAY_WEBHOOK_DEV_TOKEN=

# WhatsApp Communication (Phase 7 - WHA-01 through WHA-05)
# simulator | cloud-api. MUST stay 'simulator' in every environment until Meta
# Business verification is complete (per PROJECT.md) — a misconfigured deploy
# with this set to cloud-api would send real messages to real pet owners.
WHATSAPP_PROVIDER=simulator
# Meta Graph API version the Cloud API provider targets (07-10).
WHATSAPP_GRAPH_VERSION=v23.0
# Meta phone number ID for the clinic's WhatsApp Business number. Empty until
# Meta Business verification completes.
WHATSAPP_PHONE_NUMBER_ID=
# Meta Cloud API access token. Never commit a real value.
WHATSAPP_ACCESS_TOKEN=
# Meta app secret, used to verify inbound webhook signatures (HMAC). Never
# commit a real value.
WHATSAPP_APP_SECRET=
# Verify token Meta calls back with during webhook subscription setup. Never
# commit a real value.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Shared secret for the simulator's own local webhook endpoint (dev/test
# only, distinct from the real Meta webhook). Never commit a real value.
WHATSAPP_SIMULATOR_WEBHOOK_SECRET=
